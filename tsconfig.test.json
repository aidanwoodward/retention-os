{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": false,
    "outDir": ".test-dist",
    "rootDir": ".",
    "isolatedModules": true
  },
  "include": [
    "lib/metrics/revenue-durability-status.ts",
    "lib/metrics/revenue-durability-status.test.ts",
    "lib/metrics/product-quality.ts",
    "lib/metrics/product-quality.test.ts",
    "lib/metrics/repeat-purchase.ts",
    "lib/metrics/utils.ts",
    "lib/metrics/cohorts.ts",
    "lib/metrics/retention.ts",
    "lib/metrics/ltv.ts",
    "lib/metrics/acquisition.ts",
    "lib/metrics/acquisition-view-model.ts",
    "lib/metrics/product-quality-view-model.ts",
    "lib/metrics/dashboard-executive-spine.ts",
    "lib/metrics/dashboard-view-model.ts",
    "lib/metrics/dashboard-view-model.test.ts",
    "lib/import/normalise-marketing-spend.ts",
    "lib/demo/index.ts",
    "lib/demo/**/*.ts",
    "lib/types/**/*.ts",
    "lib/data-source/dataset-types.ts",
    "lib/data-source/dataset-helpers.ts",
    "lib/data-source/demo-source.ts"
  ]
}
